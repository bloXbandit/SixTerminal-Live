# Copy to .env and fill in. Both .env and .env.local are gitignored.
#
# Precedence, most explicit first:
#   1. a variable exported in your shell
#   2. .env.local
#   3. .env
# Nothing here overwrites something already exported.

# ── LLM (one of these; the agent needs it, file editing does not) ────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Cloudflare R2 — persistence across restarts ──────────────────────────────
# Without ALL FOUR of these, schedules live in memory only and are lost on
# every restart, sleep or crash. With them, the server saves each schedule
# (plus what you have taught it and the conversation) and restores everything
# on startup.
#
# The same values used on the server will pull the same schedules down here —
# it is one bucket, so a local run and a hosted run see the same saves.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Optional. Full endpoint URL; overrides R2_ACCOUNT_ID if you set it.
# R2_ENDPOINT=

# Optional, defaults to "schedules/". MUST match whatever wrote the data —
# the restore lists objects by this prefix, so a different value here finds
# nothing and the app starts empty with no error.
# R2_PREFIX=schedules/
